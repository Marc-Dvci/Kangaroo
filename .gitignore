target/
.toolchain/
*.jfr
*.aot
*.aotconf
data/runtime/
.idea/
*.iml
__pycache__/
.venv/

# Media: the demo video and its raw footage are large and are uploaded to the contest, not here.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
media/
footage/

# ...except the generated narration, which is committed on purpose: it is what makes the demo one
# click on a machine with no Python and no network. Rebuild it with demo/generate-voiceover.py.
!src/main/resources/web/demo/speech/*.mp3

# Native inference libraries and models are not vendored. See README, "Optional: the on-device model".
runtime/
*.gguf
*.dll
*.so
*.dylib

# A JDK fetched by packaging/fetch-jdk26.sh for local builds.
.jdk/
.jdk-download/
